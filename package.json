{
  "name": "yoruba-project",
  "version": "1.0.0",
  "description": "Yoruba grammar lessons with tone marks and word breakdowns",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "tsx scripts/validate-content.ts",
    "review": "tsx scripts/generate-review.ts",
    "audio:list": "tsx scripts/list-audio-strings.ts",
    "audio:test": "tools/audio/.venv/bin/python tools/audio/test_split.py",
    "audio:generate": "npm run audio:list && tools/audio/.venv/bin/python tools/audio/generate_elevenlabs.py",
    "e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy --name yoruba-project"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tanstack/react-router": "^1.170.44",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "type": "module",
  "private": true
}
